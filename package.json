{
  "name": "elarca",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "description": "El Arca — Archivo Comunitario. Memorial de Pedro Cabezón Jano González",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --config vite.config.js",
    "lint": "node scripts/lint.mjs",
    "styles:extract": "node scripts/extract-legacy-styles.mjs",
    "test:unit": "vitest run",
    "test": "deno test --allow-net --allow-env --allow-read supabase/functions/",
    "test:frontend": "node scripts/test-frontend.mjs",
    "format": "deno fmt supabase/functions/",
    "backup": "bash scripts/backup.sh",
    "deploy:functions": "supabase functions deploy --project-ref ukpoprkdgezgxlkjjuve",
    "deploy:frontend": "vercel --prod"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
